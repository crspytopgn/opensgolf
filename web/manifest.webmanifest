{
  "name": "OpenSGolf",
  "short_name": "OpenSGolf",
  "description": "The classic golf course builder, rebuilt: free and open source, with your own SimGolf files or free graphics.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
