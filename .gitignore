# Never commit game data or build output. The game files stay on your own disk and are read at run time.
build/
game/
*.png
*.sgc
*.sve
*.exe
*.dll
*.pcx
*.flc
*.wav
*.bik
*.ttf
*.TTF
# the bundled OFL stand-in for Arial Bold is ours to ship (see crates/simgolf/fonts/LiberationSans-OFL.txt)
!crates/simgolf/fonts/LiberationSans-Bold.ttf
# the Android launcher icon is our own drawing (tools/make_icons.sh)
!crates/simgolf/android/res/**/*.png
# the free base set's art, rendered from our own models by tools/freeset_art (packs/opensgolf-free/CREDITS.md)
!packs/opensgolf-free/art/**/*.png
__pycache__/
spec/
.DS_Store
target/
web/dist/
*.sgs
*.sgch
*.pro
Championship/
snapshots/
.claude/worktrees/
# HD art packs (tools/hd_pack) are made from the player's own copy of the game's art: never commit or ship them
HD/
hdpack*/
*.hdpack
hd_pack_out/
freeset-test/
hd-download/

# the course editor's sample heightmaps (generated by tools/heightmaps/make_heightmaps.py, not game art)
!tools/heightmaps/*.png
