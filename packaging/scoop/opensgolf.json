{
    "version": "@VERSION@",
    "description": "Open source engine for the golf course building game SimGolf, with its own free graphics and sounds",
    "homepage": "https://github.com/crspytopgn/opensgolf",
    "license": "GPL-2.0-or-later",
    "notes": "Saves and settings are in %APPDATA%\\OpenSGolf. Update with 'scoop update opensgolf' rather than the game's own Update now, so that Scoop knows the version installed.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/crspytopgn/opensgolf/releases/download/v@VERSION@/opensgolf-windows.zip",
            "hash": "@SHA256_X64@",
            "extract_dir": "opensgolf-windows"
        },
        "arm64": {
            "url": "https://github.com/crspytopgn/opensgolf/releases/download/v@VERSION@/opensgolf-windows-arm64.zip",
            "hash": "@SHA256_ARM64@",
            "extract_dir": "opensgolf-windows-arm64"
        }
    },
    "bin": "opensgolf.exe",
    "shortcuts": [
        [
            "opensgolf.exe",
            "OpenSGolf"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/crspytopgn/opensgolf/releases/download/v$version/opensgolf-windows.zip",
                "extract_dir": "opensgolf-windows"
            },
            "arm64": {
                "url": "https://github.com/crspytopgn/opensgolf/releases/download/v$version/opensgolf-windows-arm64.zip",
                "extract_dir": "opensgolf-windows-arm64"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS",
            "regex": "$sha256\\s+$basename"
        }
    }
}
